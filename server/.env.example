# Dynamic-site only. Store real values in server/.env (never commit that file).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_SECRET=
BIND=127.0.0.1
PORT=4000
APP_ENV=production
# Comma-separated proxy IP addresses or CIDRs. Never use 0.0.0.0/0.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Optional absolute paths; keep DATA_DIR outside the web root.
# DATA_DIR=/home/lyra/LyraZeta.github.io/server/data
# STATIC_ROOT=/home/lyra/LyraZeta.github.io/_site
